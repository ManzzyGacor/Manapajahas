# Salin file ini menjadi .env lalu isi nilainya.
# File .env TIDAK ikut di-commit (lihat .gitignore).
# Variabel yang diisi lewat Panel -> Startup / Variables menang atas file ini.

# ── Database (WAJIB) ─────────────────────────────────────────
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# ── Bot utama ────────────────────────────────────────────────
BOT_NUMBER=628xxxxxxxxxx
# Pisahkan dengan koma kalau lebih dari satu
OWNER_NUMBERS=628xxxxxxxxxx
# "production" mematikan hot reload plugin (default: development)
# BOT_MODE=production

# ── API pihak ketiga ─────────────────────────────────────────
AUTORESBOT_APIKEY=
ANABOT_APIKEY=
APIBOTCAHX=Varesa
# API key api.jerexd.my.id (fitur brat, play, spotify, copilot, autoreact)
JEREXD_APIKEY=
# Token GitHub (scope: repo) untuk fitur upload: .tourl, .hd, .settemplatewelcome
GITHUB_TOKEN=
# API key Tenor/Google untuk fitur .emojimix
TENOR_API_KEY=

# ── Pembayaran ───────────────────────────────────────────────
AUTOGOPAY_API_KEY=
# Biaya admin per transaksi (default 200)
# ADMIN_FEE=200

# ── Login Google (opsional, default sudah terisi) ────────────
GOOGLE_CLIENT_ID=

# ── Web & identitas server ───────────────────────────────────
# Port web. Di Pterodactyl SERVER_PORT diisi otomatis oleh panel — biarkan
# kosong kecuali jalan di luar panel. Cloudflare Tunnel harus menunjuk ke
# port yang sama (default 4526).
# SERVER_PORT=4526
# PORT=4526
# Alamat situs lengkap; dipakai bot untuk tautan "ditenagai Varesa".
# WEB_URL=https://varesa.mom
# Nama domain yang tampil di kartu server halaman depan/status & log.
# WEB_HOST=varesa.mom
# Nama & lokasi server di panel "Aktivitas server". Nama bisa juga
# diganti admin dari panel admin (pengaturan situs) tanpa restart.
# SERVER_NAME=Server 1
# SERVER_REGION=Indonesia

# ── Kapasitas bot ────────────────────────────────────────────
# Batas RAM proses utama (MB) sebelum PM2 me-restart-nya. Nilai ini dipakai
# ecosystem.config.cjs (max_memory_restart) DAN lib/monitor.js untuk
# menghitung berapa bot yang masih muat. Default 1200 (container 2 GB).
# Naikkan kalau RAM container lebih besar, mis. 3000 untuk container 4 GB.
# MAX_MEMORY_MB=1200

# ── Cloudflare Tunnel (dipakai ecosystem.config.cjs) ─────────
CF_TUNNEL_TOKEN=
